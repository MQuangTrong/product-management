extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/product-layout.pug
block main
  .main 
    .section-products-featured.my-5 
    .container.my-3 
      .row 
        .col-12 
          img(src="./images/slide.png" width="100%" alt="slide")

    .section-products-featured.my-5 
      .container.my-3 
        .row 
          .col-3
            .card.mb-3 
              .card-header Lọc theo giá
              .card-body 
                  .row 
                      .col-12
                        input(type="checkbox" name="pricefilter" id="pricefilter") 
                        label(for="pricefilter") Dưới 5$
                      .col-12
                        input(type="checkbox" name="pricefilter" id="pricefilter" ) 
                        label(for="pricefilter") Từ 5 đến 10$
                      .col-12
                        input(type="checkbox" name="pricefilter" id="pricefilter" ) 
                        label(for="pricefilter") Từ 10 đến 20$
                      .col-12
                        input(type="checkbox" name="pricefilter" id="pricefilter" ) 
                        label(for="pricefilter") Từ 20 đến 30$
                      .col-12
                        input(type="checkbox" name="pricefilter" id="pricefilter" ) 
                        label(for="pricefilter") Từ 30 đến 50$
                      .col-12
                        input(type="checkbox" name="pricefilter" id="pricefilter" )
                        label(for="pricefilter") Trên 50$
                         
                
                  
          .col-9
            .card.mb-3 
              .card-header
                .row   
                  .col-12 
                    +box-head("Sản phẩm nổi bật")
              .card-body
                +product-grid(productsFeatured)

            .card.mb-3 
              .card-header
                .row 
                  .col-12 
                    +box-head("Sản phẩm mới")
              .card-body
                +product-grid(productsNew)

