                      input(type="checkbox" name="pricefilter" id="pricefilter" ) 
                      label(for="pricefilter") Từ 30 đến 50$
                    .col-12
                      input(type="checkbox" name="pricefilter" id="pricefilter" )
                      label(for="pricefilter") Trên 50$ 
        .col-9
          .card.mb-3 
            .card-header
              .row   
                .col-12 
                  +box-head(pageTitle)
            .card-body
              +product-grid(products)
        

    
      

