extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
    +alert-success(5000)

    .container.mb-3 
        .row Danh sách 
            .col-12
                +box-head("Giỏ hàng")

        .row 
            .col-12
                table(class="table table-bordered")
                    thead 
                        tr 
                            th STT 
                            th Ảnh
                            th Tên
                            th Giá
                            th Số lượng
                            th Tổng tiền
                            th Hành động

                    tbody 
                        tr 
                            td 1
                            td 
                                img(
                                    src=""
                                    alt="Sản phẩm 1"
                                    width="80px"
                                )
                            td 500$
                            td 
                                input(
                                    type="number"
                                    name="quantity"
                                    value="1"
                                    min="1"
                                    item-id=""
                                    style="witdh: 60px"
                                )
                            td 1000$
                            td 
                                a(
                                    href="/cart/delete/:id" 
                                    class="btn btn-danger"
                                ) Xóa
                
                h3(class="text-right") Tổng đơn hàng: 1000$
                
                div(class="text-right mt-3" )
                    a(href="/checkout" class="btn btn-success") THANH TOÁN
                )Xóa